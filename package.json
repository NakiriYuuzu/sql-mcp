{
    "name": "@yuuzu/sql-mcp",
    "version": "1.1.1",
    "description": "MCP server for MSSQL, PostgreSQL, and SQLite database operations",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "sql-mcp": "./dist/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "bun run src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target node --format esm --external better-sqlite3",
        "test": "bun test",
        "test:coverage": "bun test --coverage",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "bun run build"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "better-sqlite3": "^12.8.0",
        "mssql": "^12.2.1",
        "postgres": "^3.4.9",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/bun": "latest",
        "@types/mssql": "^9.1.11",
        "typescript": "^6.0.2"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "database",
        "mssql",
        "postgresql",
        "sqlite",
        "better-sqlite3",
        "sql"
    ],
    "author": "yuuzu",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/NakiriYuuzu/sql-mcp"
    },
    "bugs": {
        "url": "https://github.com/NakiriYuuzu/sql-mcp/issues"
    },
    "homepage": "https://github.com/NakiriYuuzu/sql-mcp#readme"
}
